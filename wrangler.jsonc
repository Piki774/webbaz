{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webbaz",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "83841979-f3d9-48e4-86a8-adf24497f20d","database_name": "web" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "49fe7b7c0ea04e679329bf5f7d784d13" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
